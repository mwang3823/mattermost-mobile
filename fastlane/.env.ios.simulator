## You invoke this with --env ios.simulator on the fastlane command
AWS_BUCKET_DNS_NAME=releases.mattermost.com
AWS_FOLDER_NAME=mattermost-mobile-beta
AWS_REGION=us-east-1
FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_XCODEBUILD_SETTINGS_RETRIES=6

## Dinh danh cua ban fork Thai Duong - phai khop voi PRODUCT_BUNDLE_IDENTIFIER
## trong ios/Mattermost.xcodeproj, neu khong ValidateEmbeddedBinary se loi
APP_NAME=Mattermost
APP_SCHEME=mattermost
APP_AUTH_SCHEME=mmauth
MAIN_APP_IDENTIFIER=com.thaiduongco.chat
EXTENSION_APP_IDENTIFIER=com.thaiduongco.chat.MattermostShare
NOTIFICATION_SERVICE_IDENTIFIER=com.thaiduongco.chat.NotificationService
IOS_APP_GROUP=group.com.thaiduongco.chat
IOS_ICLOUD_CONTAINER=iCloud.com.thaiduongco.chat
IOS_KEYCHAIN_GROUP=com.thaiduongco.chat
